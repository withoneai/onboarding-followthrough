# Your One API key. After `one init`, find it in ~/.one/config.json (apiKey)
# or in the dashboard at https://app.withone.ai
ONE_SECRET=

# Your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Connection keys from `one --agent list` (the `key` field for each platform)
ONE_CONNECTION_ASANA=
ONE_CONNECTION_GOOGLE_CALENDAR=

# The Asana workspace that holds the onboarding projects. The gid is the
# long number in https://app.asana.com/0/<workspace gid>/... or from
# `one --agent actions execute asana ... "List workspaces"`.
ASANA_WORKSPACE_GID=

# Optional: only look at projects in one team (People, or Ops)
# ASANA_TEAM_GID=

# Optional: the name prefix that marks an onboarding project (default
# "Onboarding:", as in "Onboarding: Priya Raman")
# PROJECT_PREFIX=Onboarding:

# Optional: post the brief to a Slack channel. Both lines or neither.
# ONE_CONNECTION_SLACK=
# SLACK_CHANNEL=#people-ops

# Optional: which hires get checked, in days since their start date
# (default 10 to 30: the end of week two, and anyone still settling in)
# CHECK_FROM_DAY=10
# CHECK_UNTIL_DAY=30

# Optional: override the Claude model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
